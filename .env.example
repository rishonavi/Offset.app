# ─────────────────────────────────────────────────────────────
# Offset — environment configuration
# Copy this file to ".env" and fill in your values.
# ─────────────────────────────────────────────────────────────

# Supabase (cloud database + login + receipt storage)
# Create a free project at https://supabase.com, then copy these
# from your project's  Settings → API  page.
# Leave BOTH blank to run the app in local "demo mode" (data is
# stored only in this browser, no login required).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Currency shown throughout the app (ISO 4217 code). Defaults to INR.
VITE_CURRENCY=INR

# Locale used for number/date formatting. Defaults to en-IN.
VITE_LOCALE=en-IN

# Optional: Google client ID — powers BOTH "Connect Google Drive" backup AND
# "Import bills from Gmail". Create an OAuth 2.0 Web client in Google Cloud and
# paste its Client ID here. For Drive backup enable the Google Drive API; for
# Gmail import also enable the Gmail API and add the gmail.readonly scope to the
# OAuth consent screen (a Google "restricted" scope — add yourself as a Test
# user). Leave blank to hide both features.
# Note: Google / Apple SOCIAL LOGIN is configured in the Supabase dashboard,
# not here — see the README.
VITE_GOOGLE_CLIENT_ID=

# Optional: Dropbox backup. Create a "Scoped app" with "App folder" access at
# https://www.dropbox.com/developers (permissions: files.content.read/write),
# add your site URL as an OAuth redirect URI, and paste the App key here.
VITE_DROPBOX_APP_KEY=

# Optional: OneDrive backup. Register an app at https://portal.azure.com
# (platform: SPA; enable implicit "Access tokens"; delegated permission
# Files.ReadWrite.AppFolder), add your site URL as a redirect URI, and paste
# the Application (client) ID here.
VITE_MS_CLIENT_ID=

# Set to "true" to OPEN the app to everyone with NO login (data is stored
# locally in each visitor's browser). Leave blank/false to require login
# whenever Supabase is configured.
VITE_OPEN_ACCESS=

# ─────────────────────────────────────────────────────────────
# AI receipt scanning (server-side — runs in the /api function)
# ─────────────────────────────────────────────────────────────
# These are read by the serverless function at api/scan-receipt.js, NOT by the
# browser, so they have NO "VITE_" prefix and are never exposed to the client.
# Set them in your host's dashboard (e.g. Vercel → Project → Settings → Env).
#
# Your Google Gemini API key (FREE — create one at https://aistudio.google.com
# with just a Google account, no credit card). When set, "Scan to auto-fill"
# reads receipts with Gemini's vision model (much more accurate than the
# on-device OCR fallback). Leave blank to keep using the free on-device OCR.
GEMINI_API_KEY=
#
# Optional: override which Gemini model does the scanning. Leave blank to use
# the default (gemini-2.0-flash). Change it if Google renames the free model.
SCAN_MODEL=

# ─────────────────────────────────────────────────────────────
# Problem reports (server-side — runs in /api/report)
# ─────────────────────────────────────────────────────────────
# "Report a problem" in Settings keeps reports in the browser either way; these
# are what let it also email one to you. Without both, the endpoint answers 501
# and the UI falls back to a mailto link — nothing breaks, the button just
# cannot send on its own.
#
# Where reports arrive.
REPORTS_EMAIL=
# https://resend.com — the free tier is plenty for this.
RESEND_API_KEY=
# Optional: a verified sender. Defaults to Resend's sandbox address.
REPORTS_FROM=

# ─────────────────────────────────────────────────────────────
# Commercial / billing (Stripe) — see supabase/functions or BILLING.md
# ─────────────────────────────────────────────────────────────
# Turn ON plan limits (Free vs Pro). Leave blank/false and EVERYONE is treated
# as Pro (no gating) — the app behaves exactly as before.
# Note there are two halves to this: VITE_BILLING_ENABLED is the client flag
# that shows the pricing UI, and ENFORCE_PLAN_LIMITS (below, server-side) is
# what actually counts AI scans against a plan. Setting only the first shows
# prices while enforcing nothing.
VITE_BILLING_ENABLED=
# Price shown on the pricing page (major units; the real charge is your Stripe
# price). Defaults to 499.
VITE_PRO_PRICE=
#
# Server-side: count AI scans against the user's plan in /api/scan-receipt.
# Needs SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY below to know who is asking.
ENFORCE_PLAN_LIMITS=

# Server-side Stripe keys (NO VITE_ prefix — used only by /api/stripe/*).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# The webhook + portal also use SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# (server-side; find them in Supabase → Settings → API).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Live bank connection (optional) — see docs/BANK_SYNC.md
# ─────────────────────────────────────────────────────────────
# OFF by default: the app reconciles from an imported statement file. Turn this
# on only with a provider set up. Client flag (shows the "Connect a bank" button):
VITE_BANK_SYNC=
VITE_BANK_PROVIDER=plaid          # plaid (US/UK/EU) | setu (India Account Aggregator)
#
# Server-side provider keys (NO VITE_ prefix — used only by /api/bank/*):
BANK_PROVIDER=plaid
# Plaid:
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                 # sandbox | development | production
PLAID_COUNTRIES=US
# Account Aggregator (Setu/Finvu) — requires FIU registration or an AA TSP:
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
SETU_BASE_URL=https://fiu-sandbox.setu.co
BANK_REDIRECT_URL=
